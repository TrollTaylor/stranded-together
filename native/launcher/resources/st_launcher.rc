// Resources of StrandedTogether.exe: the app icon, the emblem shown in the
// window, and the version block. The .ico and .png are generated from
// docs/readme/logo.png by tools/launcher/make_launcher_assets.py.
#include <windows.h>
#include "st_launcher_resource.h"
#include "st_launcher_version.h"

IDI_ST_APP ICON "st_launcher.ico"
IDR_ST_LOGO RCDATA "st_logo.png"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ST_VERSION_MAJOR,ST_VERSION_MINOR,ST_VERSION_PATCH,0
 PRODUCTVERSION ST_VERSION_MAJOR,ST_VERSION_MINOR,ST_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Stranded Together"
            VALUE "FileDescription", "Stranded Together launcher"
            VALUE "FileVersion", ST_VERSION_STRING
            VALUE "InternalName", "StrandedTogether"
            VALUE "LegalCopyright", "A fan-made co-op mod; not affiliated with Kojima Productions, 505 Games or Sony."
            VALUE "OriginalFilename", "StrandedTogether.exe"
            VALUE "ProductName", "Stranded Together"
            VALUE "ProductVersion", ST_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
