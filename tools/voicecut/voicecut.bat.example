@echo off
rem voicecut: a local voice-line editor: cut Fragile clips from the installed game, compare them with
rem Sam's lines and export them for the mod (docs/voicecut.md). It only reads the game folder and never
rem starts the game. Copy this file to the repo root as voicecut.bat (gitignored) and double-click it.
rem It opens an app window (Edge or Chrome; else the default browser). Closing the window is enough:
rem the server exits on its own 15 minutes after the page stops asking.
rem A Python that does not run (the Windows Store "python.exe" stand-in without Python installed) is
rem skipped: each candidate must run "import sys" and be Python 3.7 or newer first. Problems while
rem starting are written to %LOCALAPPDATA%\Stranded Together\VoiceCut\voicecut.log and shown in a
rem message box.
setlocal
cd /d "%~dp0"
if not exist "tools\voicecut\voicecut.py" cd /d "%~dp0..\.."
set "CHECK=import sys; sys.exit(0 if sys.version_info >= (3, 7) else 1)"
py -3 -c "%CHECK%" >nul 2>nul && (
    where pyw >nul 2>nul && (start "" pyw -3 tools\voicecut\voicecut.py --open & exit /b 0)
    start "voicecut" /min py -3 tools\voicecut\voicecut.py --open & exit /b 0
)
python -c "%CHECK%" >nul 2>nul || goto nopython
set "PYW="
for /f "delims=" %%i in ('python -c "import os, sys; print(os.path.join(os.path.dirname(sys.executable), 'pythonw.exe'))"') do set "PYW=%%i"
if defined PYW if exist "%PYW%" (start "" "%PYW%" tools\voicecut\voicecut.py --open & exit /b 0)
start "voicecut" /min python tools\voicecut\voicecut.py --open & exit /b 0
:nopython
echo voicecut needs Python 3.7 or newer (python.org; nothing else to install).
echo The "python" on PATH did not run: on Windows 10/11 that is often the Microsoft Store stand-in
echo (Settings, Apps, Advanced app settings, App execution aliases).
pause
exit /b 1
